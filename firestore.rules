rules_version = '2';

// 로그인 없는 공개 데모용 규칙: 누구나 읽기·생성·삭제 가능, 수정(update)은 불가.
// 입력 형식·길이만 검증한다. 악의적 대량 쓰기는 막지 못한다 (README의 "보안 한계" 참고).
service cloud.firestore {
  match /databases/{database}/documents {

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function isTime(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    match /announcements/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['title', 'body', 'author', 'pinned', 'createdAt'])
        && request.resource.data.keys().hasAll(['title', 'body', 'author', 'pinned', 'createdAt'])
        && isStr(request.resource.data.title, 1, 80)
        && isStr(request.resource.data.body, 1, 2000)
        && isStr(request.resource.data.author, 1, 30)
        && request.resource.data.pinned is bool
        && isStr(request.resource.data.createdAt, 10, 40);
      allow update: if false;
      allow delete: if true;
    }

    match /reservations/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['roomId', 'date', 'start', 'end', 'owner'])
        && request.resource.data.keys().hasAll(['roomId', 'date', 'start', 'end', 'owner'])
        && isStr(request.resource.data.roomId, 1, 20)
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isTime(request.resource.data.start)
        && isTime(request.resource.data.end)
        && request.resource.data.start < request.resource.data.end
        && isStr(request.resource.data.owner, 1, 30);
      allow update: if false;
      allow delete: if true;
    }

    match /rooms/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'capacity'])
        && request.resource.data.keys().hasAll(['name', 'capacity'])
        && isStr(request.resource.data.name, 1, 30)
        && isStr(request.resource.data.capacity, 1, 3);
      allow update, delete: if false;
    }

    // 최초 시드 완료 표시
    match /meta/{id} {
      allow read: if true;
      allow create: if id == 'seed' && request.resource.data.keys().hasOnly(['seededAt']);
      allow update, delete: if false;
    }
  }
}
